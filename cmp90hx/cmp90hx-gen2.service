[Unit]
# CMP 90HX PCIe Gen2 unlock (rejoin16). Runs once per boot after the NVIDIA
# stockflow module is up; takes several minutes because each privilege-mask
# write needs its own module reload cycle (a warm reboot skips the cycles).
Description=CMP 90HX PCIe Gen2 unlock (rejoin16 PLM opens + link retrain)
After=multi-user.target
# If you auto-start a miner or other GPU work, order it After= this unit.

[Service]
Type=oneshot
# clear any stale payload-write spec left by manual cycle runs before boot
ExecStartPre=/bin/rm -f /var/lib/cmpunlocker-rs/rejoin16-next-write.bin
ExecStart=/opt/cmp50hx-unlock/cmp90hx/rejoin16-apply-all.sh
TimeoutStartSec=1800
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
