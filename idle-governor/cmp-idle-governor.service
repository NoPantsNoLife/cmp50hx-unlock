[Unit]
# Optional. The card never lowers its own P-state request, so this supervisor
# forces P8 while the GPU is idle and requests P16 as soon as work appears.
# Runtime state only: stopping the unit releases the forced state.
Description=CMP idle P-state governor (automatic idle/full state switching)
After=multi-user.target

[Service]
Type=simple
# The governor owns NVML and the private NVAPI calls directly. The service
# starts one ELF process: no shell, Python, or nvidia-smi helper is needed.
ExecStart=/opt/cmp50hx-unlock/idle-governor/cmp-governor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
