[Unit]
# Optional. The card never lowers its own clock request, so this supervisor
# applies a clock ceiling while the GPU is idle and removes it as soon as work
# appears. Runtime state only: stopping the unit releases every clamp.
Description=CMP idle clock governor (automatic idle/full clock switching)
After=multi-user.target

[Service]
Type=simple
# Persistence keeps the clamp stable when no client holds the GPU.
# ExecStopPost releases via the script so a configured CMP_LOAD_CLOCK tuning
# range is restored rather than cleared.
ExecStartPre=/usr/bin/nvidia-smi -pm 1
ExecStart=/opt/cmp50hx-unlock/idle-governor/cmp-idle-governor.sh
ExecStopPost=/opt/cmp50hx-unlock/idle-governor/cmp-idle-governor.sh --release
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
